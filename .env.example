# =========================================================
# ORCA Environment Configuration (.env)
# =========================================================

# App Runtime
PORT=8080
ENV=production
# ENV=development

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# [PRODUCTION with Supabase]
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# [LOCAL DEVELOPMENT]
# (Automatically defaulted by compose.override.yml if left unset)
# DATABASE_URL=postgres://orca:orca_secret@localhost:5432/orca_db?sslmode=disable

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h

# ---------------------------------------------------------
# REDIS CONFIGURATION
# ---------------------------------------------------------
# [PRODUCTION with Cloud Redis (e.g. Upstash, AWS ElastiCache, Redis Cloud)]
# Format: rediss://default:[password]@[endpoint]:6379
REDIS_URL=rediss://default:yourpassword@your-redis-endpoint.upstash.io:6379

# [LOCAL DEVELOPMENT]
# (Automatically defaulted by compose.override.yml if left unset)
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------
# PORTS & CORS SETTINGS
# ---------------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# Allowed Origins for Browser CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://orca.dev.ocaty.com

# ---------------------------------------------------------
# DATABASE AUTOMATIC MIGRATIONS
# ---------------------------------------------------------
# Set to true so ORCA automatically checks and runs initial schema
# migration upon container boot (ideal for first-time Supabase / Neon / Cloud Postgres setup).
AUTO_MIGRATE=true

# ---------------------------------------------------------
# SECURITY & AUTHENTICATION
# ---------------------------------------------------------
# Secret key used for signing user session JWT tokens.
# IMPORTANT: Generate a high-entropy random string for production!
JWT_SECRET=
# Generate at least 32 random bytes before deploying to production.
ALLOW_REGISTRATION=true
# Only enable for local smoke scripts; never expose this bypass publicly.
ALLOW_DEV_WORKSPACE_HEADER=false

# ---------------------------------------------------------
# OBJECT STORAGE CONFIGURATION (Images & Media)
# ---------------------------------------------------------
# Driver: "auto", "s3", or "local" (default: "auto", uses S3 if bucket configured, else local disk)
STORAGE_DRIVER=auto

# Option A: [Cloudflare R2]
# STORAGE_S3_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=orca-uploads
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=your_r2_access_key_id
# STORAGE_S3_SECRET_KEY=your_r2_secret_access_key
# STORAGE_S3_PUBLIC_URL_BASE=https://pub-<your-r2-hash>.r2.dev

# Option B: [Supabase Storage (S3 Compatible Protocol)]
# In Supabase: Project Settings -> Storage -> S3 Access Keys (Generate access key and secret)
# STORAGE_S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
# STORAGE_S3_BUCKET=orca-uploads
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_ACCESS_KEY=your_supabase_s3_access_key
# STORAGE_S3_SECRET_KEY=your_supabase_s3_secret_key
# STORAGE_S3_PUBLIC_URL_BASE=https://<your-project-ref>.supabase.co/storage/v1/object/public/orca-uploads

# Option C: [AWS S3 or MinIO]
# STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com # (or http://minio:9000 for local MinIO)
# STORAGE_S3_BUCKET=orca-uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=your_aws_access_key
# STORAGE_S3_SECRET_KEY=your_aws_secret_key
# STORAGE_S3_PUBLIC_URL_BASE=https://orca-uploads.s3.us-east-1.amazonaws.com

# Option D: [Local Storage Fallback]
# (Automatically activated when STORAGE_S3_BUCKET is empty)
STORAGE_LOCAL_DIR=./uploads
