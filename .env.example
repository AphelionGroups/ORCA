# ORCA Server Environment Configuration
PORT=8080
ENV=development

# Database Connection
DATABASE_URL=postgres://orca:orca_secret@localhost:5432/orca_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_IDLE_TIME=15m

# Redis (Optional in local dev)
REDIS_URL=redis://localhost:6379

# CORS Settings (Allow local frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
