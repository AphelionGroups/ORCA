# =========================================================
# ORCA Environment Configuration (.env)
# =========================================================

# App Runtime
PORT=8080
ENV=production
# ENV=development

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# [PRODUCTION with Supabase]
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# [LOCAL DEVELOPMENT]
# (Automatically defaulted by compose.override.yml if left unset)
# DATABASE_URL=postgres://orca:orca_secret@localhost:5432/orca_db?sslmode=disable

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h

# ---------------------------------------------------------
# REDIS CONFIGURATION
# ---------------------------------------------------------
# [PRODUCTION with Cloud Redis (e.g. Upstash, AWS ElastiCache, Redis Cloud)]
# Format: rediss://default:[password]@[endpoint]:6379
REDIS_URL=rediss://default:yourpassword@your-redis-endpoint.upstash.io:6379

# [LOCAL DEVELOPMENT]
# (Automatically defaulted by compose.override.yml if left unset)
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------
# PORTS & SSL SETTINGS
# ---------------------------------------------------------
API_PORT=8080
# Web ports (Default HTTP: 3000, HTTPS: 3443)
# To bind standard ports on production, set WEB_PORT=80 and WEB_SSL_PORT=443
WEB_PORT=3000
WEB_SSL_PORT=3443

# Force redirect HTTP traffic to HTTPS (true/false)
FORCE_SSL=false

# Allowed Origins for Browser CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3443,http://localhost:5173
